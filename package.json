{
  "name": "seasonal-calendar-moscow",
  "version": "1.0.0",
  "private": true,
  "description": "Сезонный календарь покупателя для Москвы",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm test",
    "start": "node scripts/serve.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.8"
  },
  "type": "module"
}
